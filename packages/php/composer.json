{
  "name": "swiftship/sdk-php",
  "description": "Official PHP SDK for the SwiftShip AI shipping API",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "swiftship",
    "shipping",
    "logistics",
    "sdk",
    "api"
  ],
  "homepage": "https://github.com/swiftship/swiftship-php",
  "support": {
    "issues": "https://github.com/swiftship/swiftship-php/issues",
    "source": "https://github.com/swiftship/swiftship-php"
  },
  "require": {
    "php": "^8.1",
    "ext-json": "*",
    "guzzlehttp/guzzle": "^7.8"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "mockery/mockery": "^1.6"
  },
  "autoload": {
    "psr-4": {
      "Swiftship\\Sdk\\": "src/",
      "OpenAPI\\Client\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Swiftship\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "build": "composer install --no-dev --optimize-autoloader"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}