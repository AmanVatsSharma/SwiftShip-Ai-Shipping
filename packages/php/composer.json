{
  "name": "swiftship/swiftship",
  "version": "0.1.0",
  "description": "SwiftShip AI — official PHP SDK for the public REST API. Auto-generated from the OpenAPI 3.0 spec by @openapitools/openapi-generator-cli (php template).",
  "type": "library",
  "keywords": ["swiftship", "logistics", "shipping", "openapi", "sdk"],
  "license": "MIT",
  "homepage": "https://swiftship.ai",
  "authors": [
    {
      "name": "SwiftShip AI",
      "email": "dev@swiftship.ai",
      "homepage": "https://swiftship.ai"
    }
  ],
  "support": {
    "email": "dev@swiftship.ai",
    "issues": "https://github.com/swiftship/swiftship-php/issues"
  },
  "require": {
    "php": ">=7.4 || ^8.0",
    "ext-curl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "guzzlehttp/guzzle": "^7.3",
    "guzzlehttp/psr7": "^1.7 || ^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5 || ^10.0",
    "squizlabs/php_codesniffer": "^3.5"
  },
  "autoload": {
    "psr-4": {
      "SwiftShip\\Sdk\\": "src/",
      "OpenAPI\\Client\\": "lib/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SwiftShip\\Sdk\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "validate": "composer validate --strict"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
