{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2021",
    "module": "commonjs",
    "lib": [
      "es2022",
      "dom"
    ],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@swiftship/domains/*": [
        "libs/domains/*"
      ],
      "@swiftship/shared/*": [
        "libs/shared/*"
      ],
      "@swiftship/platform/*": [
        "libs/platform/*"
      ],
      "@swiftship/platform-typeorm": [
        "libs/platform/typeorm/src/index.ts"
      ],
      "@swiftship/platform-auth": [
        "libs/platform/auth/src/index.ts"
      ],
      "@swiftship/platform-queues": [
        "libs/platform/queues/src/index.ts"
      ],
      "@swiftship/platform-carriers": [
        "libs/platform/carriers/src/index.ts"
      ],
      "@swiftship/platform-rate-cache": [
        "libs/platform/rate-cache/src/index.ts"
      ],
      "@swiftship/platform-graphql": [
        "libs/platform/graphql/src/index.ts"
      ],
      "@swiftship/platform-config": [
        "libs/platform/config/src/index.ts"
      ],
      "@swiftship/platform-throttler": [
        "libs/platform/throttler/src/index.ts"
      ],
      "@swiftship/platform-rate-math": [
        "libs/platform/rate-math/src/index.ts"
      ],
      "@swiftship/domains-*": [
        "libs/domains/*"
      ],
      "@swiftship/domains-warehouses": [
        "libs/domains/warehouses/src/index.ts"
      ],
      "@swiftship/domains-orders": [
        "libs/domains/orders/src/index.ts"
      ],
      "@swiftship/domains-shipments": [
        "libs/domains/shipments/src/index.ts"
      ],
      "@swiftship/domains-shipping-rates": [
        "libs/domains/shipping-rates/src/index.ts"
      ],
      "@swiftship/domains-carriers": [
        "libs/domains/carriers/src/index.ts"
      ],
      "@swiftship/domains-returns": [
        "libs/domains/returns/src/index.ts"
      ],
      "@swiftship/domains-users": [
        "libs/domains/users/src/index.ts"
      ],
      "@swiftship/domains-roles": [
        "libs/domains/roles/src/index.ts"
      ],
      "@swiftship/domains-billing": [
        "libs/domains/billing/src/index.ts"
      ],
      "@swiftship/domains-payments": [
        "libs/domains/payments/src/index.ts"
      ],
      "@swiftship/domains-cod": [
        "libs/domains/cod/src/index.ts"
      ],
      "@swiftship/domains-ndr": [
        "libs/domains/ndr/src/index.ts"
      ],
      "@swiftship/domains-manifests": [
        "libs/domains/manifests/src/index.ts"
      ],
      "@swiftship/domains-pickups": [
        "libs/domains/pickups/src/index.ts"
      ],
      "@swiftship/domains-webhooks": [
        "libs/domains/webhooks/src/index.ts"
      ],
      "@swiftship/domains-rate-shop": [
        "libs/domains/rate-shop/src/index.ts"
      ],
      "@swiftship/domains-surcharges": [
        "libs/domains/surcharges/src/index.ts"
      ],
      "@swiftship/domains-bulk-operations": [
        "libs/domains/bulk-operations/src/index.ts"
      ],
      "@swiftship/domains-dashboard": [
        "libs/domains/dashboard/src/index.ts"
      ],
      "@swiftship/domains-storage": [
        "libs/domains/storage/src/index.ts"
      ],
      "@swiftship/domains-tenants": [
        "libs/domains/tenants/src/index.ts"
      ],
      "@swiftship/domains-metrics": [
        "libs/domains/metrics/src/index.ts"
      ],
      "@swiftship/domains-onboarding": [
        "libs/domains/onboarding/src/index.ts"
      ],
      "@swiftship/domains-plugins": [
        "libs/domains/plugins/src/index.ts"
      ],
      "@swiftship/domains-notifications": [
        "libs/domains/notifications/src/index.ts"
      ],
      "@swiftship/domains-channels": [
        "libs/domains/channels/src/index.ts"
      ],
      "@swiftship/observability": [
        "libs/observability/src/index.ts"
      ],
      "@swiftship/shared-ui": [
        "libs/shared-ui/src/index.ts"
      ],
      "@swiftship/domains-serviceability": [
        "libs/domains/serviceability/src/index.ts"
      ],
      "@swiftship/loadtest": [
        "loadtest/src/index.ts"
      ],
      "@swiftship/shared-*": [
        "libs/shared/*"
      ],
      "config": [
        "./libs/platform/config/src/index.ts"
      ],
      "auth": [
        "./libs/platform/auth/src/index.ts"
      ],
      "queues": [
        "./libs/platform/queues/src/index.ts"
      ],
      "carriers": [
        "./libs/platform/carriers/src/index.ts"
      ],
      "graphql": [
        "./libs/platform/graphql/src/index.ts"
      ]
    }
  },
  "exclude": [
    "node_modules",
    "tmp"
  ]
}
