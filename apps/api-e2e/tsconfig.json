{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "../../dist/out-tsc",
    "module": "commonjs",
    "types": ["node", "jest"],
    "target": "es2022",
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "../api/src/**/*.ts"],
  "exclude": ["../api/src/**/*.spec.ts", "../api/src/**/*.test.ts"]
}
