{
  "entryFile": "apps/api-public/src/main.ts",
  "noImplicitAdditionalProperties": "throw-on-extras",
  "controllerPathGlobs": [
    "apps/api-public/src/controllers/**/*Controller.ts"
  ],
  "spec": {
    "outputDirectory": "apps/api-public/src/generated",
    "specVersion": 3,
    "specFile": "openapi.json",
    "name": "SwiftShip AI",
    "description": "Multi-carrier shipping API for Indian merchants",
    "version": "1.0.0"
  },
  "routes": {
    "routesDir": "apps/api-public/src/generated",
    "middleware": "express",
    "basePath": "/"
  }
}
