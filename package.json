{
  "name": "backend",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "nx": "nx",
    "serve:api": "nx serve api",
    "serve:web": "nx serve web",
    "serve:admin": "nx serve admin-portal",
    "build:all": "nx run-many --target=build --all",
    "test:all": "nx run-many --target=test --all --coverage",
    "lint:all": "nx run-many --target=lint --all",
    "typecheck:all": "nx run-many --target=typecheck --all",
    "audit:prisma": "node scripts/audit-prisma-compat.mjs",
    "graph": "nx graph",
    "build": "nest build",
    "build:nx": "nx run-many -t build",
    "format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\" \"apps/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "affected:build": "nx affected -t build",
    "affected:test": "nx affected -t test",
    "affected:lint": "nx affected -t lint",
    "loadtest:seed": "node loadtest/k6/lib/seed.js",
    "loadtest:order-create": "k6 run loadtest/k6/scenarios/order-create.js",
    "loadtest:rate-shop": "k6 run loadtest/k6/scenarios/rate-shop.js",
    "loadtest:graphql-rps": "k6 run loadtest/k6/scenarios/graphql-rps.js",
    "chaos:redis": "node chaos/scenarios/redis-down.js",
    "chaos:postgres": "node chaos/scenarios/postgres-failover.js",
    "chaos:carrier": "node chaos/scenarios/carrier-timeout.js",
    "chaos:all": "nx run-many --target=all --projects=chaos",
    "docs:api:openapi": "node scripts/generate-openapi.mjs",
    "docs:api:postman": "node scripts/refresh-postman.mjs",
    "docs:api:run": "newman run postman/SwiftShip.postman_collection.json --environment postman/SwiftShip.postman_environment.json --reporters cli,json --reporter-json-export postman/test-results.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
