{
  "name": "users",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/users/src",
  "projectType": "library",
  "tags": [
    "layer:domain",
    "scope:users",
    "team:logistics",
    "maturity:stable",
    "type:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/domains/users",
        "tsConfig": "libs/domains/users/tsconfig.lib.json",
        "packageJson": "libs/domains/users/package.json",
        "main": "libs/domains/users/src/index.ts",
        "assets": [
          "libs/domains/users/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/domains/users",
        "tsConfig": "libs/domains/users/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
