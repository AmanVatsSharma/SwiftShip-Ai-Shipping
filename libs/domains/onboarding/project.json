{
  "name": "onboarding",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/domains/onboarding/src",
  "projectType": "library",
  "tags": [
    "layer:domain",
    "scope:onboarding",
    "team:logistics",
    "maturity:stable",
    "type:domain"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/domains/onboarding",
        "tsConfig": "libs/domains/onboarding/tsconfig.lib.json",
        "packageJson": "libs/domains/onboarding/package.json",
        "main": "libs/domains/onboarding/src/index.ts",
        "assets": [
          "libs/domains/onboarding/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx tsc --noEmit -p libs/domains/onboarding/tsconfig.lib.json",
        "forwardAllArgs": false
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "jestConfig": "libs/domains/onboarding/jest.config.ts"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
