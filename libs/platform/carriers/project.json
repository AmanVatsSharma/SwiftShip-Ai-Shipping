{
  "name": "carrier-adapters",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/platform/carriers/src",
  "projectType": "library",
  "tags": [
    "layer:platform",
    "scope:shared",
    "team:platform",
    "maturity:stable",
    "type:infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/platform/carriers",
        "tsConfig": "libs/platform/carriers/tsconfig.lib.json",
        "packageJson": "libs/platform/carriers/package.json",
        "main": "libs/platform/carriers/src/index.ts",
        "assets": [
          "libs/platform/carriers/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/platform/carriers",
        "tsConfig": "libs/platform/carriers/tsconfig.lib.json",
        "main": "libs/platform/carriers/src/index.ts",
        "packageJson": "libs/platform/carriers/package.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
