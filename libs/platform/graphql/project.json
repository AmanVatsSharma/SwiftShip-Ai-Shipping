{
  "name": "graphql",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/platform/graphql/src",
  "projectType": "library",
  "tags": [
    "layer:platform",
    "scope:shared",
    "team:platform",
    "maturity:stable",
    "type:infrastructure"
  ],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/platform/graphql",
        "tsConfig": "libs/platform/graphql/tsconfig.lib.json",
        "packageJson": "libs/platform/graphql/package.json",
        "main": "libs/platform/graphql/src/index.ts",
        "assets": [
          "libs/platform/graphql/*.md"
        ]
      }
    },
    "typecheck": {
      "executor": "@nx/js:tsc",
      "outputs": [
        "{options.outputPath}"
      ],
      "options": {
        "outputPath": "dist/libs/platform/graphql",
        "tsConfig": "libs/platform/graphql/tsconfig.lib.json"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": [
        "{options.outputFile}"
      ]
    }
  }
}
